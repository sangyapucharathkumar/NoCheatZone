<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NoCheatZone" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="Theme.MySplash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#CBD3DD</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/app_icon_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.NoCheatZone</item>
    </style>
</resources>